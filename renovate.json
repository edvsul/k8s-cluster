{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "flux": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "major": {
    "enabled": true
  },
  "regexManagers": [
    {
      "fileMatch": [
        "\\.yaml$"
      ],
      "matchStrings": [
        "kind: HelmRelease[\\s\\S]*?chart:\\s+(?<depName>[^\\s]+)\\s+version:\\s+[\"']?(?<currentValue>[^\\s\"']+)"
      ],
      "datasourceTemplate": "helm"
    }
  ]
}
